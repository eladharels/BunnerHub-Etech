<?xml version="1.0" encoding="utf-8"?>
<!-- BunnerHub Etech: Play Time screen (BhPlayTimeActivity). Built from stock
     GameHub parts so it matches the native settings screens: launcher
     background, CommonTopBarView (back, title, status row), settings text styles. -->
<FrameLayout android:background="@drawable/llanuncher_bg_default" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <com.xj.common.view.CommonTopBarView android:id="@+id/bh_pt_top_bar" android:layout_width="fill_parent" android:layout_height="wrap_content" app:ctb_left_title="Play Time" />
        <TextView android:textSize="@dimen/mw_12sp" android:textColor="@color/comm_text_color_9DA0A6" android:id="@+id/bh_pt_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/mw_16dp" android:layout_marginStart="@dimen/mw_60dp" />
        <ScrollView android:id="@+id/bh_pt_scroll" android:paddingBottom="@dimen/mw_56dp" android:clipToPadding="false" android:scrollbars="none" android:layout_width="fill_parent" android:layout_height="0.0dip" android:layout_marginTop="@dimen/mw_8dp" android:layout_weight="1.0">
            <LinearLayout android:orientation="vertical" android:id="@+id/bh_pt_list" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/mw_60dp" android:layout_marginEnd="@dimen/mw_60dp" />
        </ScrollView>
    </LinearLayout>
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/bh_pt_back_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/mw_16dp" android:layout_marginEnd="@dimen/mw_24dp" android:layout_gravity="bottom|end">
        <TextView android:textSize="@dimen/mw_14sp" android:textStyle="bold" android:textColor="#ff000000" android:gravity="center" android:id="@+id/bh_pt_back_key" android:layout_width="@dimen/mw_24dp" android:layout_height="@dimen/mw_24dp" android:text="B" />
        <TextView android:textSize="@dimen/mw_14sp" android:textColor="@color/comm_white_fafafa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back" android:layout_marginStart="@dimen/mw_8dp" />
    </LinearLayout>
</FrameLayout>
