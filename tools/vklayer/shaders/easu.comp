#version 450
// AMD FidelityFX FSR 1 EASU (edge-adaptive upscale): the game's frame -> output size.
#extension GL_GOOGLE_include_directive : require
#define A_GPU 1
#define A_GLSL 1
#include "../ffx/ffx_a.h"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform Con { uvec4 con0, con1, con2, con3; } pc;

#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return textureGather(src, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(src, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(src, p, 2); }
#include "../ffx/ffx_fsr1.h"

void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(p, uvec2(imageSize(dst))))) return;
    AF3 c;
    FsrEasuF(c, p, pc.con0, pc.con1, pc.con2, pc.con3);
    imageStore(dst, ivec2(p), vec4(c, 1.0));
}
